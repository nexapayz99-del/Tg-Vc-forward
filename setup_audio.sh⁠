#!/usr/bin/env bash
set -e

echo "🔧 Installing FFmpeg, PulseAudio, and Python3 dependencies..."
sudo apt-get update -y
sudo apt-get install -y ffmpeg pulseaudio pulseaudio-utils python3-pip python3-venv

echo "🔊 Starting headless PulseAudio server..."
pulseaudio -k >/dev/null 2>&1 || true
pulseaudio --start --log-target=syslog

echo "✅ Audio Engine Ready! Per-user virtual sinks will be created dynamically by main.py."
