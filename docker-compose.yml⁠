version: '3.8'

services:
  bot:
    build: .
    container_name: nexa_vc_forwarder
    restart: always
    env_file: .env
    volumes:
      - .:/app
    depends_on:
      - mongo

  mongo:
    image: mongo:6.0
    container_name: nexa_mongo
    restart: always
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db

volumes:
  mongo_data:
